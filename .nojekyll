
#include <iostream>
#include <vector>
using namespace std;

int main() {
    int n;

    // 1. Saisir la taille du vecteur
    cout << "Donner la taille du vecteur : ";
    cin >> n;

    vector<int> T(n);

    // 2. Remplir le vecteur avec des valeurs 0 et 1
    cout << "Donner les elements (0 ou 1) :" << endl;

    for (int i = 0; i < n; i++) {
        do {
            cout << "T[" << i << "] = ";
            cin >> T[i];
        } while (T[i] != 0 && T[i] != 1);
    }

    // 3. Chercher la plus longue suite de zeros
    int longueurMax = 0;
    int position = -1;
    int longueur = 0;
    int debut = 0;

    for (int i = 0; i < n; i++) {
        if (T[i] == 0) {
            if (longueur == 0) {
                debut = i;
            }
            longueur++;

            if (longueur > longueurMax) {
                longueurMax = longueur;
                position = debut;
            }
        } else {
            longueur = 0;
        }
    }

    // 4. Supprimer la plus longue suite de zeros
    if (position != -1) {
        T.erase(T.begin() + position,
                T.begin() + position + longueurMax);
    }

    // 5. Afficher le vecteur obtenu
    cout << "Vecteur obtenu : ";

    for (int i = 0; i < T.size(); i++) {
        cout << T[i] << " ";
    }

    cout << endl;

    return 0;
}
